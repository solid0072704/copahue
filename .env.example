# Copia este archivo como .env y completa tus datos. Nunca subas el .env al repositorio.

# --- Gmail que recibe las notificaciones de FormSubmit ---
# Contraseña de aplicación: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_USER=tu.correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Cómo reconocer una descarga (ya viene listo para FormSubmit) ---
DESCARGAS_REMITENTE=submissions@formsubmit.co
DESCARGAS_ASUNTO=descarga del ebook
# Días hacia atrás que se revisan en Gmail
DESCARGAS_DIAS=120
# Correos que no son leads (pruebas tuyas, equipo). Tu GMAIL_USER y NOTIFY_EMAIL ya se excluyen.
EXCLUIR_CORREOS=

# --- Avisos para ti ---
# A dónde llegan las alertas y el resumen diario (por defecto, GMAIL_USER)
NOTIFY_EMAIL=
NOTIFY_CC=
# Segmentos que disparan alerta inmediata: Caliente, Tibio, Frío
NOTIFICAR_SEGMENTOS=Caliente
# Hora local desde la que se envía el resumen diario
RESUMEN_HORA=8

# --- Tu marca y tu oferta (se usan en los correos a los leads) ---
EMPRESA_NOMBRE=Hyperion Advisory
SITIO_WEB=https://www.hyperionadvisory.cl
FIRMA=Equipo Hyperion Advisory
EBOOK_NOMBRE=nuestro ebook
EBOOK_TEMA=análisis financiero
OFERTA_REUNION=diagnóstico financiero sin costo de 30 minutos
# Si tienes Calendly / Google Calendar (agenda de citas), los correos usan este link en vez de proponer horarios
LINK_AGENDA=

# --- Reuniones ---
ZONA_HORARIA=America/Santiago
REUNION_DURACION_MIN=30
REUNION_HORAS=10:00,12:30,16:00

# --- Seguimiento ---
# borradores = deja cada correo listo en tu Gmail (recomendado)
# automatico = lo envía solo · manual = espera tu aprobación en el tablero
SEGUIMIENTO_MODO=borradores
SEGUIMIENTO_MAX_DIA=25
# Países con puntaje extra
MERCADO_OBJETIVO=Chile
UMBRAL_CALIENTE=70
UMBRAL_TIBIO=40

# --- IA opcional (Claude) para personalizar análisis y correos ---
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
LLM_MAX_LEADS_POR_CICLO=15

# --- Archivo donde los agentes guardan su memoria ---
TABLERO_DB=data/tablero_ebook.db

# ======================================================================
# Agentes del embudo de HubSpot (python run_agentes_hubspot.py)
# ======================================================================
# Token de una app privada: HubSpot → Configuración → Integraciones → Aplicaciones privadas.
# Permisos de lectura: crm.objects.deals.read, crm.objects.owners.read, crm.schemas.deals.read.
# Para el modo "tareas" además hace falta permiso para crear tareas (HubSpot lo indica si falta).
HUBSPOT_TOKEN=
# Pipeline a vigilar: su id ("default") o su nombre tal como aparece en HubSpot ("Pipeline de ventas")
HUBSPOT_PIPELINE=default
# lectura = solo envía el informe (recomendado la primera semana) · tareas = además crea tareas en HubSpot
HUBSPOT_MODO=lectura
# Propietario de HubSpot que recibe las escalaciones (id numérico). Vacío = solo se informan.
HUBSPOT_SUPERVISOR_ID=
# Ventana en días para medir conversión y razones de pérdida
EMBUDO_DIAS=30
# A quién llega el informe (por defecto NOTIFY_EMAIL o GMAIL_USER)
EMBUDO_NOTIFY_EMAIL=
# Umbrales de días en la etapa para considerar un negocio estancado, por tipo de etapa...
DESATASCAR_DIAS_PRIMER_CONTACTO=2
DESATASCAR_DIAS_PROSPECCION=10
DESATASCAR_DIAS_VISITA=3
DESATASCAR_DIAS_NEGOCIACION=14
DESATASCAR_DIAS_ADMINISTRATIVO=45
# ...o por etapa concreta (nombre o id), separadas por coma
DESATASCAR_DIAS_POR_ETAPA=
# Máximo de tareas que se crean por ejecución y días antes de volver a insistir / escalar
DESATASCAR_MAX_TAREAS=40
DESATASCAR_REPETIR_DIAS=7
DESATASCAR_ESCALAR_DIAS=7
# Memoria e informes de estos agentes
EMBUDO_DB=data/embudo_hubspot.db
EMBUDO_INFORMES=data/informes

# ======================================================================
# Agente de caja (python run_agente_caja.py)
# ======================================================================
# Cuentas por cobrar: uno o más CSV/Excel con una fila por cuota o factura (planilla propia, contabilidad o banco).
# Columnas que reconoce solo (en cualquier orden y con nombres parecidos): empresa, cliente, compromiso/folio,
# proyecto, numero_cuota, monto, fecha_vencimiento, estado, fecha_pago. Plantilla: plantillas/cobros_plantilla.csv
COBROS_ARCHIVOS=data/cobros.csv
# Si una columna no se detecta, fíjala aquí: campo interno=columna de tu archivo
# (campos: monto, monto_pagado, vencimiento, pago, estado, numero, dias_mora, compromiso, cliente, empresa, proyecto)
COBROS_CAMPOS=
# Egresos programados y recurrentes (plantilla: plantillas/egresos_plantilla.csv)
EGRESOS_ARCHIVO=data/egresos.csv
# Saldo en bancos hoy (total, o por sociedad) y el mínimo de caja que no quieres perforar
CAJA_SALDO_INICIAL=0
CAJA_SALDOS=
CAJA_MINIMA=0
# Proyección: semanas, tasa de cobro puntual (se reemplaza por la histórica si el archivo trae pagos) y recuperación de mora
CAJA_HORIZONTE_SEMANAS=13
CAJA_TASA_COBRO=0.85
CAJA_TASA_MORA=0.25
CAJA_SEMANAS_MORA=4
# Sumar el pie de los negocios avanzados de HubSpot, ponderado por la probabilidad de su etapa (requiere HUBSPOT_TOKEN)
CAJA_INCLUIR_PIPELINE=false
CAJA_PIE_PORCENTAJE=10
CAJA_PIPELINE_PROB_MINIMA=0.5
# Solo si usas Forpay como sistema de cuotas: "Sociedad A=token,Sociedad B=token" (ver app.py)
FORPAY_EMPRESAS=
# A quién llega el informe (por defecto NOTIFY_EMAIL o GMAIL_USER), moneda y memoria
CAJA_NOTIFY_EMAIL=
CAJA_MONEDA=CLP
CAJA_DB=data/caja.db
