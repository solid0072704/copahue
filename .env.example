# Copia este archivo como .env y completa tus datos. Nunca subas el .env al repositorio.

# --- Gmail que recibe las notificaciones de FormSubmit ---
# Contraseña de aplicación: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_USER=tu.correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Cómo reconocer una descarga (ya viene listo para FormSubmit) ---
DESCARGAS_REMITENTE=submissions@formsubmit.co
DESCARGAS_ASUNTO=descarga del ebook
# Días hacia atrás que se revisan en Gmail
DESCARGAS_DIAS=120
# Correos que no son leads (pruebas tuyas, equipo). Tu GMAIL_USER y NOTIFY_EMAIL ya se excluyen.
EXCLUIR_CORREOS=

# --- Avisos para ti ---
# A dónde llegan las alertas y el resumen diario (por defecto, GMAIL_USER)
NOTIFY_EMAIL=
NOTIFY_CC=
# Segmentos que disparan alerta inmediata: Caliente, Tibio, Frío
NOTIFICAR_SEGMENTOS=Caliente
# Hora local desde la que se envía el resumen diario
RESUMEN_HORA=8

# --- Tu marca y tu oferta (se usan en los correos a los leads) ---
EMPRESA_NOMBRE=Hyperion Advisory
SITIO_WEB=https://www.hyperionadvisory.cl
FIRMA=Equipo Hyperion Advisory
EBOOK_NOMBRE=nuestro ebook
EBOOK_TEMA=análisis financiero
OFERTA_REUNION=diagnóstico financiero sin costo de 30 minutos
# Si tienes Calendly / Google Calendar (agenda de citas), los correos usan este link en vez de proponer horarios
LINK_AGENDA=

# --- Reuniones ---
ZONA_HORARIA=America/Santiago
REUNION_DURACION_MIN=30
REUNION_HORAS=10:00,12:30,16:00

# --- Seguimiento ---
# borradores = deja cada correo listo en tu Gmail (recomendado)
# automatico = lo envía solo · manual = espera tu aprobación en el tablero
SEGUIMIENTO_MODO=borradores
SEGUIMIENTO_MAX_DIA=25
# Países con puntaje extra
MERCADO_OBJETIVO=Chile
UMBRAL_CALIENTE=70
UMBRAL_TIBIO=40

# --- IA opcional (Claude) para personalizar análisis y correos ---
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
LLM_MAX_LEADS_POR_CICLO=15

# --- Archivo donde los agentes guardan su memoria ---
TABLERO_DB=data/tablero_ebook.db

# =====================================================================
# AGENTE DE INVERSIONES (tablero_trading.py / run_trading.py)
# =====================================================================

# --- Broker ---
# simulado = practicas con dinero ficticio y precios reales (recomendado para empezar)
# alpaca   = Alpaca Markets (ETFs y acciones de EE.UU.). Crea tu cuenta y claves en https://alpaca.markets
BROKER=simulado
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = cuenta de práctica (paper) de Alpaca. Para dinero real: false + TRADING_REAL=ENTIENDO_EL_RIESGO
ALPACA_PAPER=true
TRADING_REAL=
COMISION_SIMULADA_PCT=0.1
# yahoo = precios reales · sintetico = precios inventados (sin internet)
MERCADO_DATOS=yahoo

# --- Estrategia ---
# conservador, moderado o agresivo (o define tu propia cartera en CARTERA_OBJETIVO, ej: VTI:60,AGG:30,GLD:10)
PERFIL_RIESGO=moderado
CARTERA_OBJETIVO=
FILTRO_TENDENCIA=true
MEDIA_TENDENCIA_DIAS=200
# Solo propone rebalancear si un activo se desvía más de este % de su objetivo
UMBRAL_REBALANCEO_PCT=5
PLAN_CADA_HORAS=24

# --- Límites de riesgo (se aplican siempre, incluso a órdenes que apruebes) ---
RESERVA_EFECTIVO_PCT=3
MAX_POSICION_PCT=50
MIN_ORDEN_USD=10
MAX_ORDENES_DIA=12
# Propone vender una posición que cae este % bajo su costo
STOP_PERDIDA_PCT=15
# Pausa las compras si la cartera retrocede este % de lo depositado desde su máximo
FRENO_PERDIDA_PCT=20
# No ejecuta si el precio se movió más de este % desde que viste la propuesta
DESVIO_PRECIO_MAX_PCT=2
VIGENCIA_PROPUESTA_HORAS=24

# --- Cómo te consulta (Telegram recomendado) ---
# 1) Habla con @BotFather en Telegram → /newbot → copia el token
# 2) Escríbele cualquier cosa a tu bot y abre https://api.telegram.org/bot<TOKEN>/getUpdates → copia "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Si publicas el tablero (p. ej. Streamlit Cloud), el link aparece en los correos
TABLERO_TRADING_URL=

# --- Archivo donde el agente guarda su memoria ---
TRADING_DB=data/trading.db
