# Copia este archivo como .env y completa tus datos. Nunca subas el .env al repositorio.

# --- Gmail que recibe las notificaciones de FormSubmit ---
# Contraseña de aplicación: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_USER=tu.correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Cómo reconocer una descarga (ya viene listo para FormSubmit) ---
DESCARGAS_REMITENTE=submissions@formsubmit.co
DESCARGAS_ASUNTO=descarga del ebook
# Días hacia atrás que se revisan en Gmail
DESCARGAS_DIAS=120
# Correos que no son leads (pruebas tuyas, equipo). Tu GMAIL_USER y NOTIFY_EMAIL ya se excluyen.
EXCLUIR_CORREOS=

# --- Avisos para ti ---
# A dónde llegan las alertas y el resumen diario (por defecto, GMAIL_USER)
NOTIFY_EMAIL=
NOTIFY_CC=
# Segmentos que disparan alerta inmediata: Caliente, Tibio, Frío
NOTIFICAR_SEGMENTOS=Caliente
# Hora local desde la que se envía el resumen diario
RESUMEN_HORA=8

# --- Tu marca y tu oferta (se usan en los correos a los leads) ---
EMPRESA_NOMBRE=Hyperion Advisory
SITIO_WEB=https://www.hyperionadvisory.cl
FIRMA=Equipo Hyperion Advisory
EBOOK_NOMBRE=nuestro ebook
EBOOK_TEMA=análisis financiero
OFERTA_REUNION=diagnóstico financiero sin costo de 30 minutos
# Si tienes Calendly / Google Calendar (agenda de citas), los correos usan este link en vez de proponer horarios
LINK_AGENDA=

# --- Reuniones ---
ZONA_HORARIA=America/Santiago
REUNION_DURACION_MIN=30
REUNION_HORAS=10:00,12:30,16:00

# --- Seguimiento ---
# borradores = deja cada correo listo en tu Gmail (recomendado)
# automatico = lo envía solo · manual = espera tu aprobación en el tablero
SEGUIMIENTO_MODO=borradores
SEGUIMIENTO_MAX_DIA=25
# Países con puntaje extra
MERCADO_OBJETIVO=Chile
UMBRAL_CALIENTE=70
UMBRAL_TIBIO=40

# --- IA opcional (Claude) para personalizar análisis y correos ---
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
LLM_MAX_LEADS_POR_CICLO=15

# --- Archivo donde los agentes guardan su memoria ---
TABLERO_DB=data/tablero_ebook.db

# =====================================================================
# 🛍️ TIENDA CON AGENTES (run_tienda.py / tablero_tienda.py)
# =====================================================================
TIENDA_NOMBRE=Copahue Market
TIENDA_ESLOGAN=Productos que resuelven problemas, con envío a todo Chile
# URL pública (en GitHub Actions se completa sola con la de GitHub Pages)
TIENDA_URL=
# Dominio propio (opcional), p. ej. www.mitienda.cl -> se escribe el archivo CNAME
TIENDA_DOMINIO=
TIENDA_CORREO=
TIENDA_WHATSAPP=
TIENDA_RAZON_SOCIAL=
TIENDA_RUT=
TIENDA_COLOR="#0f766e"
TIENDA_COLOR_ACENTO="#ea580c"

# afiliado = ganas comisión cuando compran en AliExpress (100% automático, sin stock ni despachos)
# dropshipping = vendes tú: formulario de pedido + link de pago; tú compras al proveedor
TIENDA_MODO=afiliado

# Categorías de la tienda y búsquedas en los proveedores (en inglés rinden más). Separa categorías con ;
TIENDA_NICHOS=Hogar y cocina: kitchen gadgets, home organizer;Mascotas: pet supplies, dog accessories;Bienestar: massager, personal care;Accesorios para auto: car accessories;Tecnología útil: phone accessories, smart gadgets;Fitness en casa: home fitness, resistance bands

# --- Agente buscador ---
SCORE_MINIMO=60
MAX_PRODUCTOS_POR_NICHO=24
MAX_NUEVOS_POR_CICLO=30
PRECIO_MIN_USD=3
PRECIO_MAX_USD=80
# Palabras extra que nunca quieres vender (separadas por coma)
EXCLUIR_PALABRAS=

# --- Precios (modo dropshipping) ---
PRECIO_MULTIPLICADOR=2.6
MARGEN_MINIMO=0.30
IVA=0.19
COMISION_PASARELA=0.035
ENVIO_USD_DEFECTO=2.5
# Súbelo a 0.19 si tu proveedor NO cobra el IVA de importación
RECARGO_IMPORTACION=0
PRECIO_TERMINACION=990
# Respaldo si no se puede leer el dólar observado (mindicador.cl)
TIPO_CAMBIO=950
# Correo que recibe los pedidos (FormSubmit) y token de Mercado Pago para los links de pago
PEDIDOS_CORREO=
MERCADOPAGO_ACCESS_TOKEN=

# --- Proveedores (al menos uno) ---
# AliExpress: https://portals.aliexpress.com (Tracking ID) + https://openservice.aliexpress.com (App Key/Secret)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
# CJ Dropshipping: My CJ → Authorization → API
CJ_API_KEY=

# --- Agente de posicionamiento (SEO) ---
SUGERENCIAS_GOOGLE=true
MAX_GUIAS_POR_CICLO=2
# Cualquier texto de 8-128 letras/números: se publica como /<clave>.txt para IndexNow (Bing, Yandex…)
INDEXNOW_CLAVE=
# JSON de una cuenta de servicio de Google con acceso de lectura a tu propiedad de Search Console
GSC_CREDENCIALES=
GSC_PROPIEDAD=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
# Máximo de productos que Claude redacta por ciclo (usa ANTHROPIC_API_KEY y LLM_MODELO de arriba)
LLM_MAX_PRODUCTOS_POR_CICLO=20
