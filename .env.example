# Copia este archivo como .env y completa tus datos. Nunca subas el .env al repositorio.

# --- Gmail que recibe las notificaciones de FormSubmit ---
# Contraseña de aplicación: https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos)
GMAIL_USER=tu.correo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Cómo reconocer una descarga (ya viene listo para FormSubmit) ---
DESCARGAS_REMITENTE=submissions@formsubmit.co
DESCARGAS_ASUNTO=descarga del ebook
# Días hacia atrás que se revisan en Gmail
DESCARGAS_DIAS=120
# Correos que no son leads (pruebas tuyas, equipo). Tu GMAIL_USER y NOTIFY_EMAIL ya se excluyen.
EXCLUIR_CORREOS=

# --- Avisos para ti ---
# A dónde llegan las alertas y el resumen diario (por defecto, GMAIL_USER)
NOTIFY_EMAIL=
NOTIFY_CC=
# Segmentos que disparan alerta inmediata: Caliente, Tibio, Frío
NOTIFICAR_SEGMENTOS=Caliente
# Hora local desde la que se envía el resumen diario
RESUMEN_HORA=8

# --- Tu marca y tu oferta (se usan en los correos a los leads) ---
EMPRESA_NOMBRE=Hyperion Advisory
SITIO_WEB=https://www.hyperionadvisory.cl
FIRMA=Equipo Hyperion Advisory
EBOOK_NOMBRE=nuestro ebook
EBOOK_TEMA=análisis financiero
OFERTA_REUNION=diagnóstico financiero sin costo de 30 minutos
# Si tienes Calendly / Google Calendar (agenda de citas), los correos usan este link en vez de proponer horarios
LINK_AGENDA=

# --- Reuniones ---
ZONA_HORARIA=America/Santiago
REUNION_DURACION_MIN=30
REUNION_HORAS=10:00,12:30,16:00

# --- Seguimiento ---
# borradores = deja cada correo listo en tu Gmail (recomendado)
# automatico = lo envía solo · manual = espera tu aprobación en el tablero
SEGUIMIENTO_MODO=borradores
SEGUIMIENTO_MAX_DIA=25
# Países con puntaje extra
MERCADO_OBJETIVO=Chile
UMBRAL_CALIENTE=70
UMBRAL_TIBIO=40

# --- IA opcional (Claude) para personalizar análisis y correos ---
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5-5
LLM_MAX_LEADS_POR_CICLO=15

# --- Archivo donde los agentes guardan su memoria ---
TABLERO_DB=data/tablero_ebook.db

# =====================================================================
# Agente de YouTube Shorts (run_shorts.py) — todas estas variables son opcionales
# =====================================================================
# --- YouTube ---
# API key (solo lectura: tendencias y búsquedas). Google Cloud → APIs y servicios → Credenciales → Clave de API
YOUTUBE_API_KEY=
# OAuth de TU cuenta (para subir). Descarga el JSON del "ID de cliente OAuth" tipo Aplicación de escritorio.
YOUTUBE_CLIENT_SECRET=data/youtube_client_secret.json
YOUTUBE_TOKEN=data/youtube_token.json
# En servidores sin archivos (entornos en la nube, GitHub Actions) puedes pasar el CONTENIDO de esos JSON:
# YOUTUBE_CLIENT_SECRET_JSON={...}   YOUTUBE_TOKEN_JSON={...}
# Cuota diaria del proyecto (10 000 por defecto; cada subida cuesta 1 600 → máximo 6 subidas/día)
YOUTUBE_CUOTA_DIARIA=10000

# --- Qué buscar ---
SHORTS_REGIONES=CL,MX,ES,US
SHORTS_IDIOMAS=es
# Palabras clave de tu nicho (cada búsqueda cuesta 100 unidades de cuota)
SHORTS_TEMAS=
# Canales con permiso para reutilizar (los tuyos): IDs UC... o @handles, separados por coma. No se filtra su licencia.
SHORTS_CANALES=
# creativeCommon = solo videos con licencia Creative Commons (recomendado) · cualquiera = cualquier viral (⚠️ derechos de autor)
SHORTS_LICENCIA=creativeCommon
# Categorías de YouTube que se saltan (10 = Música)
SHORTS_CATEGORIAS_EXCLUIDAS=10
SHORTS_BUSQUEDAS_MAX=2
SHORTS_DURACION_MIN=90
SHORTS_DURACION_MAX=2700
SHORTS_PUBLICADO_HACE_DIAS=7
# Score mínimo (0-100) para recortar un video, y cuántos videos se recortan por ciclo
SHORTS_UMBRAL_VIRAL=50
SHORTS_VIDEOS_POR_CICLO=2

# --- Cómo cortar ---
SHORTS_CORTES_POR_VIDEO=2
SHORTS_CORTE_DURACION=45
SHORTS_CORTE_MIN=20
SHORTS_CORTE_MAX=60
# difuminado = video centrado sobre fondo borroso · recorte = recorta los lados al centro
SHORTS_ESTILO=difuminado
SHORTS_SUBTITULOS=true
SHORTS_ROTULO=true
SHORTS_CALIDAD_MAX=1080
SHORTS_FFMPEG_PRESET=veryfast
# Si YouTube pide "confirma que no eres un robot", exporta tus cookies (extensión "Get cookies.txt LOCALLY") a este archivo
SHORTS_COOKIES=
SHORTS_BORRAR_ORIGINAL=true

# --- Cómo publicar ---
# private (recomendado: revisas en YouTube Studio y publicas tú) · unlisted · public
SHORTS_PRIVACIDAD=private
SHORTS_MAX_SUBIDAS_DIA=3
# >0: deja cada Short programado para publicarse cada N horas (YouTube exige que suban como privados)
SHORTS_PROGRAMAR_CADA_HORAS=0
SHORTS_ETIQUETAS=Shorts
# Texto al final de cada descripción (tu canal, tu web, créditos)
SHORTS_FIRMA=
SHORTS_PARA_NINOS=false

# --- IA opcional (Claude): elige los mejores momentos y escribe títulos. Usa ANTHROPIC_API_KEY y LLM_MODELO de arriba.
# --- Archivos ---
SHORTS_DB=data/shorts.db
SHORTS_CARPETA=data/shorts
