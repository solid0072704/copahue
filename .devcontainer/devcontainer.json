{
  // Abre el repositorio en GitHub Codespaces y Tu Cartera arranca sola con una cuenta de prueba:
  //   correo prueba@tucartera.cl · contraseña prueba1234
  // Los datos quedan en data/tucartera.db dentro del codespace y se conservan al detenerlo.
  "name": "Tu Cartera",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "containerEnv": {
    "TUCARTERA_PRUEBA_EMAIL": "prueba@tucartera.cl",
    "TUCARTERA_PRUEBA_CLAVE": "prueba1234",
    "TUCARTERA_VENTAS_EMAIL": "ventas@tucartera.cl"
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {},
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && echo '✅ Dependencias instaladas'",
  "postAttachCommand": {
    "tucartera": "python -m tucartera servir --host 0.0.0.0 --puerto 8000",
    "forpay": "streamlit run app.py --server.port 8501 --server.headless true --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8000": {
      "label": "Tu Cartera",
      "onAutoForward": "openBrowser"
    },
    "8501": {
      "label": "Reportes Forpay",
      "onAutoForward": "notify"
    }
  },
  "forwardPorts": [8000, 8501]
}
